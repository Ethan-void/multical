#!/bin/sh
set -eu

REPO_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
CONFIG=${MULTICAL_PIPELINE_CONFIG:-configs/pipeline.worldgroups.DATASET.tennis.yaml}

if [ "${1:-}" = "-c" ] || [ "${1:-}" = "--config" ]; then
  if [ "$#" -lt 2 ]; then
    echo "usage: ./pipeline --config CONFIG [all|world-observe|world-extrinsic|validation CAMERA|list|dry-run]" >&2
    exit 2
  fi
  CONFIG=$2
  shift 2
fi

cd "$REPO_DIR"

case "${1:-all}" in
  use|use-config|set-config)
    if [ "$#" -lt 2 ]; then
      echo "usage: ./pipeline use PATH_OR_KEYWORD" >&2
      exit 2
    fi
    SELECTED_CONFIG=$2
    shift 2
    exec uv run python scripts/run_pipeline.py \
      --set-default-config "$SELECTED_CONFIG" "$@"
    ;;
  init)
    shift
    if [ "$#" -eq 0 ]; then
      exec uv run python scripts/run_pipeline.py \
        --init-settings configs/pipeline.init.yaml
    fi
    if [ "$1" = "--settings" ]; then
      if [ "$#" -lt 2 ]; then
        echo "usage: ./pipeline init --settings YAML" >&2
        exit 2
      fi
      SETTINGS=$2
      shift 2
      exec uv run python scripts/run_pipeline.py --init-settings "$SETTINGS" "$@"
    fi
    case "$1" in
      -*)
        exec uv run python scripts/run_pipeline.py \
          --init-settings configs/pipeline.init.yaml "$@"
        ;;
    esac
    DATASET=$1
    shift
    exec uv run python scripts/run_pipeline.py --init "$DATASET" "$@"
    ;;
  all)
    shift 2>/dev/null || true
    exec uv run python scripts/run_pipeline.py \
      --config "$CONFIG" --stage all --resume "$@"
    ;;
  validation|validate)
    if [ "$#" -lt 2 ]; then
      echo "usage: ./pipeline validation CAMERA" >&2
      exit 2
    fi
    CAMERA=$2
    shift 2
    exec uv run python scripts/run_pipeline.py \
      --config "$CONFIG" --stage validation --camera "$CAMERA" --resume "$@"
    ;;
  world-observe|observe-world)
    shift
    exec uv run python scripts/run_pipeline.py \
      --config "$CONFIG" \
      --stage observe_world_01,observe_world_23,observe_world_45 --resume "$@"
    ;;
  world-extrinsic|world-manual)
    shift
    exec uv run python scripts/run_pipeline.py \
      --config "$CONFIG" \
      --stage world_manual_01,world_manual_23,world_manual_45,worldgroups_manual,worldgroupba_manual \
      --resume "$@"
    ;;
  analyze|analysis)
    if [ "$#" -lt 2 ]; then
      echo "usage: ./pipeline analyze intrinsic|extrinsic|worldgroups|all" >&2
      exit 2
    fi
    TARGET=$2
    shift 2
    case "$TARGET" in
      intrinsic) STAGE=intrinsic_analysis ;;
      extrinsic) STAGE=extrinsic_analysis ;;
      worldgroups|groups) STAGE=analyze_worldgroups ;;
      all|combined) STAGE=intrinsic_analysis,extrinsic_analysis,report ;;
      *)
        echo "usage: ./pipeline analyze intrinsic|extrinsic|worldgroups|all" >&2
        exit 2
        ;;
    esac
    exec uv run python scripts/run_pipeline.py \
      --config "$CONFIG" --stage "$STAGE" --resume "$@"
    ;;
  list)
    shift
    exec uv run python scripts/run_pipeline.py \
      --config "$CONFIG" --list-stages "$@"
    ;;
  dry-run|check)
    shift
    exec uv run python scripts/run_pipeline.py \
      --config "$CONFIG" --dry-run "$@"
    ;;
  stage)
    shift
    if [ "${1:-}" = "-c" ] || [ "${1:-}" = "--config" ]; then
      if [ "$#" -lt 2 ]; then
        echo "usage: ./pipeline stage [--config CONFIG] STAGE [pipeline options]" >&2
        exit 2
      fi
      CONFIG=$2
      shift 2
    fi
    if [ "$#" -eq 0 ] || [ "${1#-}" != "$1" ]; then
      echo "usage: ./pipeline stage [--config CONFIG] STAGE [pipeline options]" >&2
      exit 2
    fi
    STAGE=$1
    shift
    exec uv run python scripts/run_pipeline.py \
      --config "$CONFIG" --stage "$STAGE" --resume "$@"
    ;;
  *)
    # A leading path or keyword selects the config for this invocation.
    case "$1" in
      -*) ;;
      *) CONFIG=$1; shift ;;
    esac
    # Advanced mode: pass normal run_pipeline.py options directly.
    exec uv run python scripts/run_pipeline.py --config "$CONFIG" "$@"
    ;;
esac
